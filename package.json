{
  "name": "contractsutra-ai",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "ContractSutra AI: local-first OpenAPI breaking-change detector. Direction-aware request/response rules, JSON-pointer findings, declared consumer impact, SARIF, CI exit-code gate, hash-chained audit log and independent audit reports in Markdown, HTML and JSON. 22 agent roles, 29 portable skills. Zero dependencies, no API keys.",
  "author": {
    "name": "Vatsal Shah",
    "url": "https://github.com/shahvatsalofficial"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "contractsutra": "./src/cli/main.mjs",
    "contractsutra-ai": "./src/cli/main.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "doctor": "node src/cli/main.mjs doctor",
    "audit": "node src/cli/main.mjs audit --dir examples/reports/demo --out audit-out",
    "proof": "node scripts/proof.mjs",
    "docs:build": "node documents/build.mjs",
    "pack:check": "npm pack --dry-run",
    "lint": "node scripts/lint.mjs"
  },
  "homepage": "https://shahvatsalofficial.github.io/contractsutra-ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahvatsalofficial/contractsutra-ai.git"
  },
  "bugs": {
    "url": "https://github.com/shahvatsalofficial/contractsutra-ai/issues"
  },
  "keywords": [
    "openapi",
    "openapi-diff",
    "breaking-changes",
    "api-compatibility",
    "backward-compatibility",
    "api-contract",
    "contract-testing",
    "consumer-driven-contracts",
    "sarif",
    "ci-gate",
    "audit-trail",
    "agent-skills",
    "claude-code",
    "cursor",
    "codex",
    "mcp",
    "cli",
    "offline",
    "zero-dependencies"
  ],
  "files": [
    "src",
    "skills",
    "agents",
    ".claude/agents",
    "adapters",
    "fixtures",
    "schemas",
    "rules",
    "workflows",
    "policies",
    "plugins",
    "integrations",
    "docs",
    "examples",
    "scripts/demo.mjs",
    "scripts/proof.mjs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
